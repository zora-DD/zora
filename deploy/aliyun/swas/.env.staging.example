# 复制为 .env.staging；这里只保存非敏感配置，权限仍建议设为 0600。
ZORA_DOMAIN=zora-agent.top
ZORA_ACME_EMAIL=CHANGE_ME

# ACR 个人版私有仓库公网地址；版本标签必须不可变，禁止长期使用 latest。
ZORA_IMAGE=crpi-bn9tjq61qbvw8e3l.cn-hongkong.personal.cr.aliyuncs.com/zora-agent/zora:v0.12.0

# GitHub OAuth App 的 Client ID 可以明文配置；Client Secret 必须写入 .secrets 文件。
ZORA_GITHUB_OAUTH_CLIENT_ID=Ov23liYxCcnXhs0Wknsd

# LLM 与 Embedding 参数保存在忽略提交的 .runtime/ai-config.json；真实 Key 保存在 .secrets。
# 修改 LLM 配置后重启 Zora 生效；修改 Embedding 模型或维度前必须规划向量重建。

# staging 默认关闭多 Agent 控制模型成本；验证基础链路后可按需开启。
ZORA_MULTI_AGENT_ENABLED=false
ZORA_REQUEST_TIMEOUT=120s
ZORA_MAX_ITERATIONS=8

# 限流与日配额用于避免公开测试环境被滥用。
ZORA_RATE_LIMIT_REQUESTS_PER_SECOND=5
ZORA_RATE_LIMIT_BURST=10
ZORA_DAILY_REQUEST_QUOTA=2000
ZORA_DAILY_CHAT_QUOTA=100
ZORA_DAILY_UPLOAD_BYTES_QUOTA=52428800
