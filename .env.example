# 服务配置
ZORA_ADDR=:8088
# 本地数据库会写入该目录；生产环境请挂载持久卷。
ZORA_DATA_DIR=./data

# mock：无需 API Key，适合本地开发和自动化测试。
# openai：适用于 OpenAI-compatible 接口，包括 DashScope/通义千问。
ZORA_MODEL_PROVIDER=mock
ZORA_MODEL=qwen-plus
ZORA_API_KEY=
ZORA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 同时限制 HTTP 请求与一次 Agent 执行，避免任务无限占用连接。
ZORA_REQUEST_TIMEOUT=90s
# ReAct 最大迭代次数；一次“思考 -> 工具 -> 观察”会占用一次或多次迭代。
ZORA_MAX_ITERATIONS=8

# 知识库配置
# hash：零密钥、可复现，用于本地开发和链路测试，不是生产语义模型。
# openai：调用 OpenAI-compatible /embeddings 接口。
ZORA_EMBEDDING_PROVIDER=hash
ZORA_EMBEDDING_MODEL=text-embedding-v4
# openai 模式可单独设置；留空时复用 ZORA_API_KEY 和 ZORA_BASE_URL。
ZORA_EMBEDDING_API_KEY=
ZORA_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# hash 默认 384 维；openai 默认 1024 维。切换后需重建旧文档索引。
ZORA_EMBEDDING_DIMENSIONS=
# 按 Unicode 字符计算，overlap 必须小于 chunk size 的一半。
ZORA_KNOWLEDGE_CHUNK_SIZE=800
ZORA_KNOWLEDGE_CHUNK_OVERLAP=120
