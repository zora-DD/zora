# 本地使用：复制为 .env.local，再填写真实密钥；不要在本文件中填写或提交密钥。
# make run 会自动读取 .env.local（优先）或 .env。

# 服务配置
ZORA_ADDR=:8088
# 本地数据库会写入该目录；生产环境请挂载持久卷。
ZORA_DATA_DIR=./data/embedding-v4
# sqlite：默认零依赖模式；postgres：生产向量检索模式。
ZORA_STORE_PROVIDER=sqlite
# 仅 postgres 模式使用，密码请通过 Secret 注入，不要提交真实凭据。
ZORA_POSTGRES_DSN=postgres://zora:zora@localhost:5432/zora?sslmode=disable
ZORA_POSTGRES_MAX_CONNS=10

# 可观察性配置（默认关闭，不影响零依赖启动）
# 开启后通过 OTLP/HTTP 导出 Trace；本地 Jaeger 可执行 make observability-up。
ZORA_OTEL_ENABLED=false
OTEL_SERVICE_NAME=zora
ZORA_OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# 根 Trace 采样率范围 0–1；开发期建议 1，生产环境按流量和成本下调。
ZORA_OTEL_SAMPLE_RATIO=1
# 开启后在 GET /metrics 暴露 Prometheus 指标；该端点不记录 Prompt、正文或工具参数。
ZORA_PROMETHEUS_ENABLED=false

# mock：无需 API Key，适合本地开发和自动化测试。
# openai：适用于 OpenAI-compatible 接口，包括 DashScope/通义千问。
ZORA_MODEL_PROVIDER=mock
ZORA_MODEL=qwen-plus
ZORA_API_KEY=
ZORA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选多模型配置。JSON 中只能引用密钥环境变量名，禁止直接填写 api_key。
# 未配置时继续使用上面的单模型变量，保持向后兼容。
DEEPSEEK_API_KEY='请在 .env.local 中填写真实 Key'
ZORA_DEFAULT_MODEL_ID='deepseek-pro'
ZORA_MODELS_JSON='[
  {
    "id": "local-mock",
    "name": "本地 Mock",
    "provider": "mock"
  },
  {
    "id": "deepseek-flash",
    "name": "DeepSeek V4 Flash",
    "provider": "openai",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "extra_fields": {
      "thinking": {
        "type": "disabled"
      }
    }
  },
  {
    "id": "deepseek-pro",
    "name": "DeepSeek V4 Pro",
    "provider": "openai",
    "model": "deepseek-v4-pro",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "extra_fields": {
      "thinking": {
        "type": "disabled"
      }
    }
  }
]'
# ZORA_DEFAULT_MODEL_ID=local-mock
# 注意：作为 Shell 环境文件使用时，JSON 外层必须加单引号。
# ZORA_MODELS_JSON='[{"id":"local-mock","name":"本地 Mock","provider":"mock"},{"id":"deepseek-flash","name":"DeepSeek V4 Flash","provider":"openai","model":"deepseek-v4-flash","base_url":"https://api.deepseek.com","api_key_env":"DEEPSEEK_API_KEY","extra_fields":{"thinking":{"type":"disabled"}}},{"id":"deepseek-pro","name":"DeepSeek V4 Pro","provider":"openai","model":"deepseek-v4-pro","base_url":"https://api.deepseek.com","api_key_env":"DEEPSEEK_API_KEY","extra_fields":{"thinking":{"type":"disabled"}}}]'
# 同时限制 HTTP 请求与一次 Agent 执行，避免任务无限占用连接。
ZORA_REQUEST_TIMEOUT=90s
# ReAct 最大迭代次数；一次“思考 -> 工具 -> 观察”会占用一次或多次迭代。
ZORA_MAX_ITERATIONS=8
# 多 Agent 会增加模型调用次数，默认关闭；开启后由 Supervisor 调度研究、文档和写作专家。
ZORA_MULTI_AGENT_ENABLED=true
# 单轮最多交接 6 次、最多并行 3 个专家；每次专家调用独立超时并允许 1 次重试。
ZORA_MULTI_AGENT_MAX_HANDOFFS=6
ZORA_MULTI_AGENT_MAX_PARALLEL=3
ZORA_MULTI_AGENT_SPECIALIST_TIMEOUT=30s
ZORA_MULTI_AGENT_RETRY_COUNT=1
# off：不审批；risky：仅高影响关键词；all：每次多 Agent 请求都审批。
ZORA_MULTI_AGENT_APPROVAL_MODE=risky
# 审批等待计入整条 HTTP 请求超时，默认应小于 ZORA_REQUEST_TIMEOUT。
ZORA_MULTI_AGENT_APPROVAL_TIMEOUT=60s

# 知识库配置
# hash：零密钥、可复现，用于本地开发和链路测试，不是生产语义模型。
# openai：调用 OpenAI-compatible /embeddings 接口。
ZORA_EMBEDDING_PROVIDER=openai
ZORA_EMBEDDING_MODEL=text-embedding-v4
# openai 模式可单独设置；留空时复用 ZORA_API_KEY 和 ZORA_BASE_URL。
ZORA_EMBEDDING_API_KEY='请在 .env.local 中填写真实 Key'
ZORA_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# hash 默认 384 维；openai 默认 1024 维。切换后需重建旧文档索引。
ZORA_EMBEDDING_DIMENSIONS=1024
# 按 Unicode 字符计算，overlap 必须小于 chunk size 的一半。
ZORA_KNOWLEDGE_CHUNK_SIZE=800
ZORA_KNOWLEDGE_CHUNK_OVERLAP=120
# 当前版本是单用户部署，主体由服务端固定配置；未来接入登录后由鉴权中间件覆盖。
ZORA_KNOWLEDGE_PRINCIPAL_ID=local-user
# 跨会话只召回用户原话；消息向量和长期记忆向量使用独立索引表。
ZORA_MESSAGE_RECALL_ENABLED=true
ZORA_MESSAGE_RECALL_LIMIT=3
ZORA_MESSAGE_RECALL_MIN_SCORE=0.55

# 长期记忆配置
# 成功回答后提取候选并执行去重/冲突合并；关闭后仍可手动管理记忆。
ZORA_MEMORY_AUTO_CAPTURE=true
# 每轮最多接纳的候选数量，范围 1–10；限制额外模型成本和错误放大。
ZORA_MEMORY_MAX_CANDIDATES=3
# 召回可独立关闭，用于 A/B 对照；关闭不会影响记忆写入和管理。
ZORA_MEMORY_RECALL_ENABLED=true
ZORA_MEMORY_RECALL_LIMIT=5
# 相关性、重要性、时效性联合分数门槛，范围 0–1。
ZORA_MEMORY_RECALL_MIN_SCORE=0.25
# 自动捕获使用事务 Outbox + 后台 Worker。任务只保存消息 ID，失败按指数退避重试。
ZORA_MEMORY_WORKER_POLL_INTERVAL=1s
# 单任务超时默认跟随 ZORA_REQUEST_TIMEOUT；租约必须严格大于单任务超时。
ZORA_MEMORY_WORKER_TASK_TIMEOUT=90s
ZORA_MEMORY_WORKER_LEASE_DURATION=2m
ZORA_MEMORY_WORKER_RETRY_BASE=2s
# 包含首次执行，范围 1–20；耗尽后任务进入 failed，可通过状态 API 排查。
ZORA_MEMORY_WORKER_MAX_ATTEMPTS=5

# 长对话摘要与上下文压缩
# 达到阈值后，将较早消息增量合并为摘要；原始消息仍保留在数据库中，不会删除。
ZORA_SUMMARY_ENABLED=true
# 尚未摘要消息达到 20 条时触发，范围 4–500。
ZORA_SUMMARY_TRIGGER_MESSAGES=20
# 最近 12 条消息保留原文，至少为 2 且必须小于触发阈值。
ZORA_SUMMARY_KEEP_RECENT=12
# 摘要正文上限，按 Unicode 字符计，范围 500–20000。
ZORA_SUMMARY_MAX_RUNES=4000

# MCP 办公连接器（默认关闭）
# 先执行 make build-mcp-files，再把授权根目录设置为专门的办公资料目录，避免授权整个用户目录。
ZORA_MCP_ENABLED=false
ZORA_MCP_FILES_ROOT=/absolute/path/to/office-files
# Microsoft 只读连接器：生产推荐 client_credentials + Secret 文件；三种鉴权方式只能选一种。
# 1) 开发期短期令牌；2) 可轮换令牌文件；3) tenant/client ID + client secret 文件。
ZORA_MCP_MICROSOFT_ACCESS_TOKEN=
ZORA_MCP_MICROSOFT_ACCESS_TOKEN_FILE=
ZORA_MCP_MICROSOFT_TENANT_ID=
ZORA_MCP_MICROSOFT_CLIENT_ID=
ZORA_MCP_MICROSOFT_CLIENT_SECRET_FILE=
ZORA_MCP_MICROSOFT_OAUTH_BASE_URL=https://login.microsoftonline.com
# client_credentials 固定使用 Graph /.default，不允许请求任意 scope。
ZORA_MCP_MICROSOFT_OAUTH_SCOPE=https://graph.microsoft.com/.default
ZORA_MCP_MICROSOFT_BASE_URL=https://graph.microsoft.com/v1.0
# 应用身份不能使用 me，必须明确指定专用邮箱。
ZORA_MCP_MICROSOFT_USER_ID=me
# 普通 Agent 连接器永远保持 false；默认只注册四个只读工具。
ZORA_MCP_MICROSOFT_WRITE_ENABLED=false
# 真实写执行器默认关闭。显式启用后，写工具只由审批后的 Operation 调用，不会进入 Agent 工具列表。
ZORA_OFFICE_EXECUTOR=disabled
# 启用 microsoft_graph 时必填；先运行 make build-mcp-microsoft。
ZORA_OFFICE_EXECUTOR_COMMAND=./bin/zora-mcp-microsoft
# 子进程参数使用 JSON 数组，留空表示没有参数。
ZORA_OFFICE_EXECUTOR_ARGS_JSON=[]
# 写执行器使用另一套 Entra 应用和 Secret，避免只读连接器继承写权限。
ZORA_OFFICE_MICROSOFT_TENANT_ID=
ZORA_OFFICE_MICROSOFT_CLIENT_ID=
ZORA_OFFICE_MICROSOFT_CLIENT_SECRET_FILE=
ZORA_OFFICE_MICROSOFT_OAUTH_BASE_URL=https://login.microsoftonline.com
ZORA_OFFICE_MICROSOFT_OAUTH_SCOPE=https://graph.microsoft.com/.default
ZORA_OFFICE_MICROSOFT_BASE_URL=https://graph.microsoft.com/v1.0
ZORA_OFFICE_MICROSOFT_USER_ID=
# 必须与 ZORA_OFFICE_EXECUTOR=microsoft_graph 同时显式开启，形成双重写门禁。
ZORA_OFFICE_MICROSOFT_WRITE_ENABLED=false
# 每个 Server 都必须显式列出只读工具；command 和 args 分开传递，不会经过 Shell。
# pass_env 是该子进程唯一能继承的环境变量，Zora 的模型 Key、Embedding Key 和数据库 DSN 会被拒绝。
ZORA_MCP_SERVERS_JSON='[{"name":"files","command":"./bin/zora-mcp-files","args":[],"allowed_tools":["list_files","read_text_file"],"pass_env":["PATH","TMPDIR","ZORA_MCP_FILES_ROOT"]}]'
# 同时启用文件与 Microsoft Graph 的示例：
# ZORA_MCP_SERVERS_JSON=[{"name":"files","command":"./bin/zora-mcp-files","args":[],"allowed_tools":["list_files","read_text_file"],"pass_env":["PATH","TMPDIR","ZORA_MCP_FILES_ROOT"]},{"name":"microsoft","command":"./bin/zora-mcp-microsoft","args":[],"allowed_tools":["search_emails","get_email","list_calendar_events","get_calendar_event"],"pass_env":["PATH","TMPDIR","ZORA_MCP_MICROSOFT_TENANT_ID","ZORA_MCP_MICROSOFT_CLIENT_ID","ZORA_MCP_MICROSOFT_CLIENT_SECRET_FILE","ZORA_MCP_MICROSOFT_USER_ID"]}]
ZORA_MCP_CONNECT_TIMEOUT=10s
ZORA_MCP_CALL_TIMEOUT=20s
# 防止大段工具结果占满模型上下文，范围 1000–100000。
ZORA_MCP_MAX_OUTPUT_RUNES=12000
